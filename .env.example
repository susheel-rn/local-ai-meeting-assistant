# Audio capture settings
AUDIO_SAMPLE_RATE=48000
AUDIO_CHUNK_DURATION=1.0
AUDIO_QUEUE_SIZE=128
TRANSCRIPTION_CHUNK_DURATION=8
TRANSCRIPTION_OVERLAP_DURATION=1
AUDIO_CAPTURE_MICROPHONE=true
AUDIO_CAPTURE_SYSTEM=true
AUDIO_RECORDINGS_ENABLED=true
WHISPER_MODEL=small
TRANSCRIPTION_LANGUAGE=
COMPUTE_DEVICE=auto
COMPUTE_TYPE=
VAD_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
DATABASE_PATH=meeting_data.db
RECORDINGS_DIR=recordings
EXPORTS_DIR=exports
LOG_LEVEL=INFO

